{
  "synced_root": "corpus",
  "model": "claude-sonnet-5",
  "judge_model": "claude-opus-5",
  "max_turns": 30,
  "timeout_s": 900,
  "exclude": [
    "~$*", "*.tmp", "*.bak", ".git", "desktop.ini",
    "*.pdf", "*.pptx", "*.docx", "*.xlsx", "*.xlsm", "*.xlsb",
    "*.mp4", "*.mov", "*.wav", "*.m4a", "*.png", "*.jpg", "*.jpeg",
    "*.zip", "*.doc", "*.xls"
  ],
  "variants": {
    "current": null,
    "trimmed": "variants/trimmed.md",
    "empty": ""
  }
}
